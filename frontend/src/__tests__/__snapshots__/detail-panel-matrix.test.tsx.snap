exports[`DetailPanel dispatch matrix > renders ocean-acidification after data loads 1`] = `
<div>
  <div
    aria-label="Feature details"
    aria-live="polite"
  >
    <div
      class="fixed z-overlay w-80 max-h-[80vh] overflow-y-auto custom-scrollbar rounded-xl border border-white/10 bg-surface-primary shadow-2xl"
      style="left: 688px; top: 60px;"
    >
      <div
        class="flex items-center justify-between px-4 py-3 border-b border-white/5 cursor-grab active:cursor-grabbing select-none"
      >
        <span
          class="text-white/65 text-[13px] uppercase tracking-widest mb-1.5 font-sans truncate pr-2 mb-0"
        >
          Ocean Acidification (GLODAP Ω)
        </span>
        <button
          aria-label="Close"
          class="text-white/60 hover:text-white text-lg leading-none transition-colors shrink-0"
        >
          ×
        </button>
      </div>
      <div
        class="px-4 py-4"
      >
        <div
          class="mb-3 px-2 py-1.5 rounded-lg bg-orange-500/10 border-orange-500/20 border"
        >
          <p
            class="text-orange-400 text-[14px] font-sans"
          >
            Ω fields are GLODAP's authoritative mapped climatology; the aragonite saturation-horizon depth is platform-derived.
             
            Platform-derived. Aragonite saturation was reconstructed with PyCO2SYS from GLODAP's present-day and preindustrial dissolved inorganic carbon using one identical configuration, then differenced. "Today" is GLODAP's mapped reference year, nominally ~2002 — this compares two climatology snapshots and is not a rate or trend. The reconstruction reproduces GLODAP's own published aragonite saturation to within 0.002 units.
          </p>
        </div>
        <span
          class="inline-block text-[14px] font-mono border rounded px-1.5 py-0.5 mb-2 text-rose-300 border-rose-500/40"
        >
          Ocean Acidification (GLODAP)
        </span>
        <p
          class="text-sm text-white/80 mb-3"
        >
          Nearest GLODAP cell · 
          1.23
          °, 
          4.56
          ° · 
          100
           m
        </p>
        <div
          class="mb-4"
        >
          <p
            class="text-white/65 text-[13px] uppercase tracking-widest mb-1.5 font-sans"
          >
            Saturation state
          </p>
          <div
            class="overflow-x-auto rounded border border-white/10"
          >
            <table
              class="w-full text-[11px] font-mono"
            >
              <thead
                class="sticky top-0 bg-black/70 text-white/70"
              >
                <tr>
                  <th
                    class="text-left px-2 py-1 font-normal"
                  >
                    Variable
                  </th>
                  <th
                    class="text-right px-2 py-1 font-normal"
                  >
                    Ω
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr
                  class="odd:bg-white/[0.025]"
                >
                  <td
                    class="px-2 py-0.5 text-white/85"
                  >
                    Aragonite (ΩA)
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    1.80
                  </td>
                </tr>
                <tr
                  class="odd:bg-white/[0.025]"
                >
                  <td
                    class="px-2 py-0.5 text-white/85"
                  >
                    Calcite (ΩC)
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    2.60
                  </td>
                </tr>
                <tr
                  class="odd:bg-white/[0.025]"
                >
                  <td
                    class="px-2 py-0.5 text-white/85"
                  >
                    Aragonite saturation horizon
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    2500 m
                  </td>
                </tr>
                <tr
                  class="odd:bg-white/[0.025]"
                >
                  <td
                    class="px-2 py-0.5 text-white/85"
                  >
                    Horizon shift since preindustrial
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    400 m
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <p
            class="text-[11px] text-white/60 mt-1"
          >
            Ω &lt; 1 → corrosive; aragonite dissolves.
          </p>
        </div>
        <div
          class="mt-3 rounded border border-orange-500/30 bg-orange-500/10 px-2 py-1.5"
        >
          <p
            class="text-[10px] font-semibold text-orange-300 mb-0.5"
          >
            Citation required
          </p>
          <p
            class="text-[11px] text-white/75 leading-relaxed break-words"
          >
            TEST GLODAP citation
          </p>
        </div>
        <p
          class="text-[11px] text-white/65 mt-2"
        >
          Source:
           
          <a
            class="text-rose-400 hover:underline"
            href="https://glodap.info"
            rel="noopener noreferrer"
            target="_blank"
          >
            GLODAP v2.2016b Mapped Climatology 
            <span
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        </p>
      </div>
    </div>
  </div>
</div>
`;

