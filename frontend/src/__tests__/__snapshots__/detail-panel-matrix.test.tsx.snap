                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-white/70"
                  >
                    800
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    0.3%
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    0.2%
                  </td>
                </tr>
                <tr
                  class="odd:bg-white/[0.025]"
                >
                  <td
                    class="px-2 py-0.5 text-white/85"
                  >
                    ≥ 
                    0.7
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-white/70"
                  >
                    400
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    0.3%
                  </td>
                  <td
                    class="px-2 py-0.5 text-right text-rose-300"
                  >
                    0.3%
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div
          class="mt-3 rounded border border-orange-500/30 bg-orange-500/10 px-2 py-1.5"
        >
          <p
            class="text-[10px] font-semibold text-orange-300 mb-0.5"
