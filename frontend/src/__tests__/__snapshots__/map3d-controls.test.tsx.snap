exports[`Map3DControls representative filters > expands and snapshots the methane-seeps filter chips 1`] = `"<div class="text-white/65 text-[13px] mb-0.5 flex items-center justify-between"><span>Feature type</span></div><button aria-label="Toggle Gas bubbles / flares" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(239, 68, 68); border-color: rgb(239, 68, 68);"></span><span class="text-white">Gas bubbles / flares</span></button><button aria-label="Toggle Gas hydrate" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(34, 211, 238); border-color: rgb(34, 211, 238);"></span><span class="text-white">Gas hydrate</span></button><button aria-label="Toggle Mound" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(251, 191, 36); border-color: rgb(251, 191, 36);"></span><span class="text-white">Mound</span></button><button aria-label="Toggle Pockmark" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(96, 165, 250); border-color: rgb(96, 165, 250);"></span><span class="text-white">Pockmark</span></button><button aria-label="Toggle Chemosynthetic community" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(52, 211, 153); border-color: rgb(52, 211, 153);"></span><span class="text-white">Chemosynthetic community</span></button><button aria-label="Toggle Carbonate hardground" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(167, 139, 250); border-color: rgb(167, 139, 250);"></span><span class="text-white">Carbonate hardground</span></button>"`;

exports[`Map3DControls representative filters > expands and snapshots the submarine-cables filter chips 1`] = `"<div class="text-white/65 text-[13px] mb-0.5 flex items-center justify-between"><span>Data sources:</span></div><button aria-label="Toggle EMODnet (global telecom)" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(251, 191, 36); border-color: rgb(251, 191, 36);"></span><span class="text-white">EMODnet (global telecom)</span></button><button aria-label="Toggle NOAA Marine Cadastre" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(251, 191, 36); border-color: rgb(251, 191, 36);"></span><span class="text-white">NOAA Marine Cadastre</span></button><button aria-label="Toggle LINZ (NZ Hydrographic)" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(251, 191, 36); border-color: rgb(251, 191, 36);"></span><span class="text-white">LINZ (NZ Hydrographic)</span></button><button aria-label="Toggle ACMA (AU protection zones)" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(251, 191, 36); border-color: rgb(251, 191, 36);"></span><span class="text-white">ACMA (AU protection zones)</span></button><button aria-label="Toggle ONC (NE Pacific observatory)" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(34, 211, 238); border-color: rgb(34, 211, 238);"></span><span class="text-white">ONC (NE Pacific observatory)</span></button><button aria-label="Toggle OOI RCA (Oregon observatory)" aria-pressed="true" class="flex items-center gap-1.5 w-full text-left text-[13px] py-0.5 transition-opacity opacity-100"><span class="w-2 h-2 rounded-full flex-shrink-0 border" style="background-color: rgb(232, 121, 249); border-color: rgb(232, 121, 249);"></span><span class="text-white">OOI RCA (Oregon observatory)</span></button><div class="text-white/60 text-[11px] mt-1 leading-snug">EMODnet shows global telecom routes; NOAA Marine Cadastre adds US cable corridor protection zones (anchoring-prohibited polygon footprints, including ~371 freshwater Great Lakes cables); LINZ adds chart-symbology cable lines in NZ EEZ; ACMA adds three federal cable protection zones off Sydney and Perth; ONC shows the NEPTUNE/VENUS fibre-optic cables off British Columbia; OOI shows the Regional Cabled Array off Oregon (approximate routes — segments connect published node coordinates).</div>"`;

exports[`Map3DControls representative filters > expands and snapshots the tailings filter chips 1`] = `"<div class="flex items-center justify-between mb-1"><p class="text-white/70 text-[10px] uppercase tracking-wider">Hazard Rating</p></div><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(27, 158, 119);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(27, 158, 119);"></span><span class="text-white/75 text-[13px]">Low</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(217, 95, 2);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(217, 95, 2);"></span><span class="text-white/75 text-[13px]">High</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(117, 112, 179);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(117, 112, 179);"></span><span class="text-white/75 text-[13px]">Significant</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(231, 41, 138);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(231, 41, 138);"></span><span class="text-white/75 text-[13px]">Medium</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(102, 166, 30);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(102, 166, 30);"></span><span class="text-white/75 text-[13px]">Very High</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(230, 171, 2);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(230, 171, 2);"></span><span class="text-white/75 text-[13px]">Extreme</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(166, 118, 29);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(166, 118, 29);"></span><span class="text-white/75 text-[13px]">Other</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="w-3 h-3" style="accent-color: rgb(148, 148, 148);"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background: rgb(148, 148, 148);"></span><span class="text-white/75 text-[13px]">No rating published</span></label><p class="text-white/70 text-[10px] uppercase tracking-wider mt-2 mb-1">Status</p><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="accent-red-400 w-3 h-3"><span class="text-white/75 text-[13px]">Active</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="accent-red-400 w-3 h-3"><span class="text-white/75 text-[13px]">Inactive</span></label><label class="flex items-center gap-2 py-0.5 cursor-pointer"><input type="checkbox" class="accent-red-400 w-3 h-3"><span class="text-white/75 text-[13px]">Closed</span></label>"`;

exports[`Map3DControls representative filters > expands and snapshots the wod-oxygen filter chips 1`] = `"<div class="flex flex-col gap-2"><div class="flex items-center justify-between"><span class="text-[11px] font-mono text-white/70 uppercase tracking-wide">Decade</span></div><div class="flex flex-wrap gap-1"><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(59, 31, 107); border-color: rgb(59, 31, 107);">1900s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(74, 42, 138); border-color: rgb(74, 42, 138);">1910s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(63, 58, 168); border-color: rgb(63, 58, 168);">1920s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(47, 95, 192); border-color: rgb(47, 95, 192);">1930s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(31, 134, 200); border-color: rgb(31, 134, 200);">1940s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(26, 163, 176); border-color: rgb(26, 163, 176);">1950s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(27, 181, 138); border-color: rgb(27, 181, 138);">1960s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(63, 192, 106); border-color: rgb(63, 192, 106);">1970s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(134, 200, 63); border-color: rgb(134, 200, 63);">1980s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(200, 192, 32); border-color: rgb(200, 192, 32);">1990s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(232, 160, 32); border-color: rgb(232, 160, 32);">2000s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(239, 122, 26); border-color: rgb(239, 122, 26);">2010s</button><button class="px-2 py-0.5 rounded text-[11px] font-mono border transition-colors border-transparent text-white" style="background-color: rgb(226, 59, 59); border-color: rgb(226, 59, 59);">2020s</button></div><div class="flex flex-wrap gap-x-2 gap-y-0.5 mt-1"><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(59, 31, 107);"></span>1900s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(74, 42, 138);"></span>1910s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(63, 58, 168);"></span>1920s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(47, 95, 192);"></span>1930s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(31, 134, 200);"></span>1940s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(26, 163, 176);"></span>1950s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(27, 181, 138);"></span>1960s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(63, 192, 106);"></span>1970s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(134, 200, 63);"></span>1980s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(200, 192, 32);"></span>1990s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(232, 160, 32);"></span>2000s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(239, 122, 26);"></span>2010s</span><span class="flex items-center gap-1 text-[10px] font-mono text-white/70"><span class="inline-block w-2 h-2 rounded-full flex-shrink-0" style="background-color: rgb(226, 59, 59);"></span>2020s</span></div></div>"`;

exports[`Map3DControls whole-panel snapshots > matches the default store state 1`] = `"<div data-panel="layers" class="z-panel bg-[rgba(10,14,20,0.95)] border border-white/[0.08] rounded flex flex-col overflow-hidden absolute top-4 left-4 w-72 max-h-[calc(100vh-7rem)]"><div class="flex items-center justify-between px-3 py-1.5 border-b border-white/[0.06] shrink-0"><div class="flex items-center gap-2"><span data-tutorial="layers-panel" class="text-white/75 text-[10px] font-mono uppercase tracking-widest">Layers</span><button title="Views" class="text-white/60 hover:text-cyan-300 text-[9px] font-mono uppercase tracking-widest transition-colors border border-white/10 hover:border-cyan-400/40 rounded px-1.5 py-0.5">Views</button></div><div class="flex items-center gap-2"><div class="relative inline-flex items-center gap-1.5 bg-black/40 rounded border border-white/15 px-2 py-0.5 cursor-pointer hover:border-white/40 focus-within:border-white/60"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-3.5 h-3.5 text-white/80 shrink-0"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"></path></svg><span class="text-sm font-semibold leading-none text-white/95 tracking-wide">EN</span><select aria-label="Language: English" title="English" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"><option value="en">English</option><option value="pl">Polski</option><option value="fr">Français</option><option value="de">Deutsch</option></select></div><button aria-label="Close layers panel" class="text-white/65 hover:text-white text-sm leading-none transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center -mr-2">×</button></div></div><div class="overflow-y-auto custom-scrollbar flex-1 px-2 py-1 space-y-px"><button aria-expanded="true" aria-label="Toggle Sea Data section" class="flex items-center justify-between w-full text-left py-1.5 group"><span class="text-white/80 text-[10px] font-mono uppercase tracking-[0.15em] group-hover:text-white/90 transition-colors">Sea Data</span><span class="text-white/60 text-[10px] font-mono group-hover:text-white/70 transition-colors">▴</span></button><div class="pl-2 border-l border-white/[0.06]"><div class="mt-4"><button aria-expanded="true" aria-label="Toggle Claims &amp; Zones sub-section" class="flex items-center justify-between w-full text-left pt-2 pb-1 border-t border-white/[0.06] group"><span class="text-white/70 text-[10px] font-mono uppercase tracking-[0.12em] group-hover:text-white/85 transition-colors">Claims &amp; Zones</span><span class="text-white/55 text-[10px] font-mono group-hover:text-white/70 transition-colors">▴</span></button><div class="mt-0.5"><div class="relative transition-opacity duration-150 opacity-65"><div class="flex items-center gap-2 group py-0.5"><div class="shrink-0 w-5 h-5 flex items-center justify-center"><button aria-label="Expand filters" aria-expanded="false" class="w-full h-full flex items-center justify-center text-white/70 hover:text-white/85 transition-colors relative -m-2 p-2"><span class="text-[13px] leading-none font-mono">+</span></button></div><label class="flex items-center gap-2 flex-1 cursor-pointer min-w-0"><input type="checkbox" class="sr-only peer"><div class="w-3 h-3 rounded-sm shrink-0 border transition-colors" style="background-color: transparent; border-color: rgb(0, 242, 255);"></div><span class="text-[13px] text-white/85 truncate">Mining Concessions</span></label><button aria-label="Info about Mining Concessions" aria-expanded="false" class="shrink-0 w-5 h-5 flex items-center justify-center text-white/70 hover:text-white/90 active:text-white/90 transition-colors"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.0