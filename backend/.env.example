# This file is kept in sync with the code by backend/tests/test_env_example_completeness.py,
# which parses every backend/**/*.py (excluding backend/tests/) with `ast` and asserts every
# os.getenv/os.environ name it finds has a line below. If that test fails after you add a new
# `os.getenv(...)` call, add the missing NAME= line here (with a one-line comment) rather than
# editing the test.
#
# ⛔ No real values below — names, `=`, and placeholders only. Never paste a value from your
# local backend/.env into this file.

# --- Required — the app fails to boot without these (no fallback in code) ---

# Postgres connection string. backend/main.py reads this via os.environ["DATABASE_URL"]
# with no default, so an unset var is a bare KeyError at startup, not a graceful skip.
DATABASE_URL=postgresql://user:password@localhost:5432/abyssal

# Keys the per-IP hash stored by backend/routers/feedback.py (HMAC-SHA256, ip_hash
# column). If unset, feedback submission still works, but ip_hash is stored as NULL
# and the per-IP rate limit is disabled (see the comment in feedback.py) — set a real
# random value in production, both for the rate limit and for the privacy guarantee in
# the published privacy policy. Never reuse this example value.
FEEDBACK_IP_SALT=replace-with-a-long-random-value-never-this-literal

# --- Optional — feature keys with fallbacks; the app boots and just skips the feature ---

# Legacy Supabase integration. Not read anywhere in the current backend (grepped
# 2026-09 — zero hits outside this file); kept only in case a fork still wires it up.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ONC_TOKEN=your_onc_api_token_here

# --- Raw vessel verification pipeline (Phase 0–4 rebuild) ---
# AISStream.io — free WebSocket, unlimited, no rate limits on bbox subs
AISSTREAM_API_KEY=your_aisstream_token_here
# Copernicus Data Space Ecosystem (CDSE) — Sentinel-1 SAR + Sentinel-2 optical
# Create an OAuth2 client at https://identity.dataspace.copernicus.eu
CDSE_CLIENT_ID=your_cdse_client_id
CDSE_CLIENT_SECRET=your_cdse_client_secret

# AIS ingestor tunables (safe defaults)
AIS_AOI_BUFFER_KM=25
AIS_RETENTION_DAYS=14
AIS_BATCH_SIZE=200
AIS_BATCH_INTERVAL_S=5
FEATURE_AIS_LIVE=1
# Widens AIS ingestion to the full configured AOI instead of a narrower default;
# backend/ais_sync.py defaults this to "1" (on) when unset.
FEATURE_WIDE_AIS=1

# Dark-vessel alerts (Phase 5). Generic JSON webhook — works with Slack
# incoming-webhooks, Discord, n8n, or any custom endpoint. Leave blank to
# disable alerts entirely.
ALERT_WEBHOOK_URL=
# Origin used to build absolute URLs (map link, S2 thumbnail) in the
# alert payload. Override for dev/staging if needed.
ALERT_SITE_ORIGIN=https://something-rare.com

# Absolute path to the Telegram alert helper invoked by api_access/notify.py.
# There is no built-in default: unset means alerts are skipped, and the log
# says so. Set it wherever alerts are actually wanted.
NOTIFY_SCRIPT=

# --- Admin panel + API-key subsystem ---

# Bearer token gating every admin dashboard endpoint (require_admin_token in
# backend/auth.py). Defaults to "" — an empty token makes hmac.compare_digest's
# "is it configured" check fail closed, so every admin route 403s until you set
# this. The admin panel can also rotate it at runtime (routers/admin_layers_api.py).
ADMIN_DASHBOARD_TOKEN=
# Seeds the frontend BFF's row into the api_access key table at startup
# (main.py's seed_internal_key) and is the emergency env-fallback key that
# api_access/auth.py accepts if the DB/cache is unreachable. Without it, the
# BFF proxy still authenticates via whatever key is already seeded in the DB;
# there is just no env-driven fallback if that DB row is ever lost.
ABYSSAL_API_KEY=
# Set to "1" by the deploy script on the short-lived warm-standby uvicorn
# (port 8769) that nginx fails over to while abyssal-api restarts. Tells
# main.py's lifespan() to skip spawning the ~35 background/sync tasks — a
# standby that outlived its ~30s and kept them would duplicate every sync.
# Nobody else should set this.
ABYSSAL_STANDBY=
# First super-admin account, created once at startup (main.py's
# bootstrap_super_admin; idempotent, no-op if an admin already exists). Without
# BOTH set, no super-admin is bootstrapped and the admin panel has no way in
# until one is created by some other route.
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Request-log GeoIP enrichment (MaxMind GeoLite2) ---
# ⛔ Never commit the .mmdb files themselves — MaxMind EULA forbids redistribution
# (see DATA-LICENCES.md). Fetch them under your own MaxMind account. Without
# these, backend/api_access/geoip.py simply skips country/ASN enrichment on
# request logs — nothing else breaks.
GEOIP_COUNTRY_DB=/path/to/GeoLite2-Country.mmdb
GEOIP_ASN_DB=/path/to/GeoLite2-ASN.mmdb

# --- Per-layer sync/ingest credentials — each sync logs and skips if unset ---

# NASA FIRMS wildfire layer (domains/land/hazards.py). Empty default; without
# it, the FIRMS sync just returns no rows.
FIRMS_MAP_KEY=
# OpenAQ air-quality layer (domains/land/hazards.py). Same empty-default,
# silent-skip pattern as FIRMS_MAP_KEY above.
OPENAQ_API_KEY=
# Copernicus Marine (CMEMS) credentials for the ocean-currents sync and bake
# (services/ocean_currents.py, services/currents_bake.py). Without both set,
# the currents sync logs and returns early instead of authenticating.
CMEMS_USERNAME=
CMEMS_PASSWORD=
# Toitu Te Whenua LINZ API key for the NZ submarine cables ingest
# (ingestion/nz_cables_ingest.py). Empty default; without it that one ingest
# source is skipped (other cable sources are unaffected).
LINZ_API_KEY=
# MEMENTO portal credentials for the one-time authenticated geochemistry scrape
# (domains/geochem.py sync_memento). Without both set, the sync logs
# "MEMENTO_EMAIL/MEMENTO_PASSWORD not set — skipping" and does nothing.
MEMENTO_EMAIL=
MEMENTO_PASSWORD=
# Dryad OAuth2 client credentials for the SAMBAH acoustic-monitoring ingest
# (ingestion/acoustic_sambah_ingest.py). Read via os.environ[...] (no getenv
# default) inside that ingest job only — a KeyError there, not at app startup;
# the ingest also has its own guarded os.environ.get(...) pre-check that logs
# and skips instead of crashing when either is unset.
DRYAD_CLIENT_ID=
DRYAD_CLIENT_SECRET=

# --- Misc integrations ---

# Feedback-form Discord webhook (routers/feedback.py). Unset means feedback
# is still stored in the DB but never forwarded to Discord.
DISCORD_FEEDBACK_WEBHOOK=
# IndexNow key for push-notifying search engines of new/changed URLs
# (indexnow.py). Empty default; without it, IndexNow pings are skipped.
INDEXNOW_KEY=
# psql/GDAL password for the one-off KBA download script
# (scripts/download_kbas.py). Defaults to the placeholder "CHANGE_ME" in that
# script if unset — harmless for local runs against a passwordless dev DB, but
# set it for anything that actually needs to authenticate.
PGPASSWORD=
# Alternate Postgres URL used only by scripts/ci_bootstrap_db.py in CI, as a
# fallback when DATABASE_URL is not set. Not needed for local dev.
TEST_DATABASE_URL=
# Logging verbosity for the standalone sync/ingest worker processes
# (obis_sync_worker.py, vme_bake_worker.py, ais_ingestor.py). Defaults to INFO.
LOG_LEVEL=INFO
# Overrides schema_steps.resolve_git_sha()'s `git rev-parse HEAD` lookup — set
# by the deploy environment when the running tree is not a git checkout (e.g.
# a built container image with no .git directory). Not needed for local dev.
# Also read by main.py's lifespan() to compare against schema_migrations.git_sha.
ABYSSAL_GIT_SHA=
# Per-step wall-clock timeout (seconds) for scripts/migrate.py, the pre-restart
# deploy gate. Defaults to 300. lifespan() no longer runs the schema steps
# itself (see migrate.py), so this is now the only such timeout.
ABYSSAL_MIGRATE_STEP_TIMEOUT_S=
# lock_timeout set on scripts/migrate.py's connection pool, so all fifteen
# schema steps inherit it. Defaults to 15s. A lock within this window is
# retried (up to the step timeout above); past it the run fails rather than
# restart onto a schema the code does not expect.
ABYSSAL_MIGRATE_LOCK_TIMEOUT=
# How often scripts/migrate.py retries a step after a lock-timeout error,
# in seconds. Defaults to 15. Lowering it retries more often within the same
# per-step budget; it does not change that budget (ABYSSAL_MIGRATE_STEP_TIMEOUT_S).
ABYSSAL_MIGRATE_LOCK_RETRY_EVERY_S=
# ⛔ TEST SEAM, NOT AN OPERATIONAL KNOB — never set this on a real deployment.
# Read only by scripts/migrate.py: when set to a step's name, that step raises
# and migrate.py stops the run and exits 1 without touching it or any step
# after it. It exists only so tests/test_migrate_script.py can prove the
# deploy gate actually stops a run — there is no legitimate reason to set it
# outside that test.
ABYSSAL_MIGRATE_FAIL_AT=
# ⛔ TEST SEAM, NOT AN OPERATIONAL KNOB — never set this on a real deployment.
# Read only by scripts/migrate.py: when set to a step's name, that step raises
# a lock-shaped error on its first attempt only, then succeeds — so migrate.py
# retries it once and continues. It exists only so
# tests/test_migrate_script.py can prove the retry path (not just the
# fail-and-stop path above) actually runs — there is no legitimate reason to
# set it outside that test.
ABYSSAL_MIGRATE_LOCK_AT=
# ⛔ TEST SEAM, NOT AN OPERATIONAL KNOB — never set this on a real deployment.
# Read only by scripts/migrate.py: when set (any non-empty value), the
# post-schema seed_aois_from_existing_layers() call raises instead of running,
# so migrate.py takes its non-fatal path — logs the error, prints a WARN line,
# still writes schema_migrations and exits 0. It exists only so
# tests/test_migrate_script.py can prove a failed AOI seed never blocks a
# deploy — there is no legitimate reason to set it outside that test.
ABYSSAL_MIGRATE_AOI_SEED_FAIL=

# --- Cache / raster / scratch directory overrides ---
# Every one of these defaults to a /var/cache/abyssal-* path baked into the
# source (already public — see the file named). Override only when that
# default path isn't writable, e.g. for local dev off a read-only /var.
ACID_CACHE_DIR=              # services/acidification.py, default /var/cache/abyssal-acidification
ARCTIC_RASTER_DIR=           # domains/arctic.py, default /var/cache/abyssal-arctic-raster
BATHY_CACHE_DIR=             # services/bathymetry_stats.py, default /var/cache/abyssal-bathymetry
BATHY_GRID_DIR=              # services/bathymetry_grid_export.py, default /var/cache/abyssal-bathymetry-grid
CARBON_CACHE_DIR=            # services/glodap_carbon.py, default /var/cache/abyssal-carbon
CASCADE_CACHE_DIR=           # services/cascade_grid.py, default /var/cache/abyssal-cascade
CASCADE_RASTER_DIR=          # domains/arctic.py, default /var/cache/abyssal-cascade-raster
CASCADE_RAW_DIR=             # domains/arctic.py, default /var/cache/abyssal-cascade/raw
CHI_CACHE_DIR=               # services/chi_impact.py, default /var/cache/abyssal-chi
CHI_RASTER_DIR=              # domains/fields/habitat.py, default /var/cache/abyssal-chi-raster
CURRENTS_CACHE_DIR=          # services/currents_bake.py, default /var/cache/abyssal-currents
OBIS_SCRATCH_DIR=            # ingestion/obis_parquet.py, default /var/cache/abyssal-obis-tmp
OXYGEN_CACHE_DIR=            # services/oxygen_deox.py, default /var/cache/abyssal-oxygen
RASTER_TILE_CACHE_DIR=       # routers/spatial_v2.py + offshore_tile_baker.py, default /var/cache/abyssal-tiles-raster
SEABED_CACHE_DIR=            # services/seabed_lithology.py, default /var/cache/abyssal-seabed
SEABED_RASTER_DIR=           # domains/fields/habitat.py, default /var/cache/abyssal-seabed-raster
SIO_BIC_CACHE_DIR=           # ingestion/sio_bic_ingest.py, default /var/cache/sio-bic
SOCAT_CACHE_DIR=             # services/socat_co2.py, default /var/cache/abyssal-socat
TILE_CACHE_DIR=              # routers/spatial_v2.py, default /var/cache/abyssal-tiles
VME_CACHE_DIR=               # services/vme_sdm.py, default /var/cache/abyssal-vme
WOA_CACHE_DIR=               # services/woa_climatology.py, default /var/cache/abyssal-woa
WOD_CACHE_DIR=               # ingestion/wod_oxygen_ingest.py, default /var/cache/wod-oxygen

# Optional owner-only runtime token file; overrides ADMIN_DASHBOARD_TOKEN.
# Required on the isolated VPS so rotation never rewrites the deploy .env.
ADMIN_DASHBOARD_TOKEN_FILE=
